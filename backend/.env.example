# Copy to .env — do not commit .env

# LLM (mock | openai | auto)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.commandcode.ai/provider/v1
OPENAI_MODEL=meta/muse-spark-1.3-contributor
LLM_PLANNER_MODEL=meta/muse-spark-1.3-contributor
LLM_TEMPERATURE=0.2
LLM_CONTEXT_TOKENS=1048576
LLM_MAX_TOKENS=131072
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT_CHEAP=low
LLM_REASONING_EFFORT_STANDARD=medium
LLM_REASONING_EFFORT_STRONG=medium
LLM_REASONING_EFFORT_PLANNER=medium
PLANNER_FIRST=true
MAX_CLARIFY_REPLANS=3

# Embeddings (hash fallback when VOYAGE_API_KEY is empty)
EMBEDDINGS_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
EMBEDDINGS_DIM=1024

# Database (SQLite default; empty CHECKPOINT_DB_PATH uses Postgres checkpointer)
DATABASE_URL=sqlite+aiosqlite:///./data/orchestrator.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# MCP
MCP_SERVERS_CONFIG=config/mcp_servers.yaml
JIRA_MCP_HOST=127.0.0.1
JIRA_MCP_PORT=8001

# Agents / memory
AGENTS_CONFIG_DIR=config/agents
EPISODIC_TTL_DAYS=14
SUMMARIZATION_THRESHOLD=0.80
SUMMARIZATION_RESET=0.30
PRICING_JSON=config/pricing.yaml
WORKER_MAX_TOOL_ROUNDS=4
WORKER_MAX_TOOL_ROUNDS_ANALYST=3
WORKER_MAX_TOOLS_PER_WAVE=6

# App
LOG_LEVEL=INFO
LOG_JSON=false
DEMO_USER_ID=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600
API_TOKEN=
CHAT_RATE_LIMIT_PER_MINUTE=30
